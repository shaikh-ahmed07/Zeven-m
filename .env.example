# Public site URL (used for SEO / Open Graph links)
NEXT_PUBLIC_SITE_URL=https://www.zevenm.com

# Where /api/enquiry forwards every enquiry as JSON (CRM, Zapier/Make, Google Apps Script, Slack…).
# Leave empty and forms will tell visitors online enquiries are unavailable (nothing is faked).
ENQUIRY_WEBHOOK_URL=

# Optional: post forms straight to an external service instead of /api/enquiry.
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://formspree.io/f/xxxxxxx
